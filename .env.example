# Copy this file to .env in the repo root and fill in your own values:
#   cp .env.example .env
#
# docker-compose.yaml has sensible defaults for ALL variables, so an empty .env
# works for local dev WITHOUT OAuth. Only set what you need to override.
#
# NEVER commit real secrets/credentials. Keep them in .env (gitignored); this
# .env.example carries placeholders only.
#
# ===========================================================================
# LOCAL DEV: same-origin edge at https://meet.localhost + local identity
# service (issuer https://id.localhost) fronted by a HOST Caddy.
#
# Split-horizon OAuth:
#   * BROWSER-facing URLs -> https://id.localhost / https://meet.localhost
#                            (the browser trusts the host Caddy CA).
#   * BACKEND container   -> http://host.docker.internal:8081/...
#                            (plain HTTP, container-reachable, no TLS/CA needed).
#
# Flow: browser PKCE (public client). The UI redirects to
# https://id.localhost/oauth/authorize; the provider redirects back to
# https://meet.localhost/auth/callback, where the browser exchanges the code
# itself (PKCE, no client_secret) and stores the id_token in sessionStorage.
# That id_token is the Bearer the chat client sends to smatter. (OAUTH_FLOW=pkce
# below selects this; leave it unset to fall back to the server-side flow.)
# ===========================================================================

# --- OAuth (shared where browser & backend agree) ---
ENABLE_OAUTH=true
DIOXUS_SERVE_PORT=3002
# Register your OWN public PKCE client (token-endpoint auth = none, Require PKCE
# S256) in the identity service and put its client id here.
OAUTH_CLIENT_ID=<your-videocall-client-id>
# Leave BLANK for the PKCE flow (a public client exchanges with no secret). Only
# needed for the server-side confidential fallback (OAUTH_FLOW unset).
OAUTH_CLIENT_SECRET=

# Browser PKCE flow (public client). The browser exchanges the auth code directly
# with id.localhost and stores the id_token in sessionStorage (vc_id_token), which
# the chat client sends as the Bearer to smatter. Mirrors the cc7 pattern.
# Requires the videocall client to be PUBLIC (token-endpoint auth = none) + PKCE S256.
OAUTH_BROWSER_PKCE=true
OAUTH_FLOW=pkce

# Browser-facing redirect URI. In PKCE flow the UI redirects here (/auth/callback),
# the page exchanges the code with id.localhost and stores the id_token.
# >>> REGISTER THIS EXACT VALUE for your videocall client in the identity service.
OAUTH_REDIRECT_URL=https://meet.localhost/auth/callback

# Browser-facing identity endpoints (browser trusts host Caddy CA).
OAUTH_AUTH_URL=https://id.localhost/oauth/authorize
OAUTH_END_SESSION_URL=https://id.localhost/oauth/end_session

# Post-login / post-logout land on the same-origin edge.
AFTER_LOGIN_URL=https://meet.localhost
AFTER_LOGOUT_URL=https://meet.localhost
ALLOWED_REDIRECT_URLS=https://meet.localhost

# Same-origin API base so all browser API calls (/api/v1/*, /login, /logout,
# /profile, /session, /version, ...) go through the meet.localhost edge.
API_BASE_URL=https://meet.localhost

# Cookies ride https://meet.localhost — must be Secure.
COOKIE_SECURE=true
# CORS: same-origin, but set explicitly so credentialed requests are allowed.
CORS_ALLOWED_ORIGIN=https://meet.localhost

# NOTE: OAUTH_ISSUER is intentionally NOT set for the local stack. meeting-api
# runs OIDC discovery at startup whenever OAUTH_ISSUER is set and the fetch is
# FATAL on failure; https://id.localhost is unreachable from inside the container.
# Leaving it unset means `iss` is not pinned (signature + aud + exp ARE still
# verified via JWKS). LOCAL DEV ONLY.

# --- Service URLs (defaults match docker-compose) ---
# Meeting signaling websocket rides the same-origin edge as wss:// so it is NOT
# blocked as mixed content from the https://meet.localhost page (Safari blocks
# ws://localhost from an https origin). Caddy proxies /lobby* -> websocket-api
# (host :8086, container :8080).
ACTIX_UI_BACKEND_URL=wss://meet.localhost
# WEBTRANSPORT_HOST=https://127.0.0.1:4433

# --- JWT ---
# JWT_SECRET=<set-a-local-dev-jwt-secret>
